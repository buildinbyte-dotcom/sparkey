# Supabase project (create in the Sydney / ap-southeast-2 region)
# Found under Project Settings -> API Keys in the Supabase dashboard.
# Use the Publishable key (sb_publishable_...) — or the legacy anon key (eyJ...)
# on older projects. Never use the Secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Base URL of the deployed app (used in auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables the "Tidy with AI" question formatter on the ask page.
# Leave unset to hide the feature entirely. Server-side only — never exposed
# to the browser. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override; defaults to gpt-4.1-mini
OPENAI_MODEL=

# Contact address shown on /privacy and /support. Required before App Store submission.
NEXT_PUBLIC_SUPPORT_EMAIL=

# App Store / Google Play reviewer account. Only this email may use the password
# sign-in at /login/review (reviewers can't receive emailed codes). Create the user
# with a password in Supabase (Authentication -> Users -> Add user) and give it a
# verified profile. Server-side only. Leave unset to disable review sign-in.
APP_REVIEW_EMAIL=

# Apple Developer Team ID (10 characters). Enables the universal links file at
# /.well-known/apple-app-site-association so sparkyq.com links open the iOS app.
# Leave unset to serve a 404. See docs/app-store/push-and-links.md.
APPLE_TEAM_ID=
